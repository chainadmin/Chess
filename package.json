{
  "name": "shiftchess-expo",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/game/__tests__/tsconfig.json && tsc --noEmit -p src/online/__tests__/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "test": "node --import tsx --test src/game/__tests__/*.test.ts src/online/__tests__/*.test.ts",
    "check": "npm run typecheck && npm test",
    "online:server": "node --import tsx server/index.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/native": "^7.3.4",
    "@react-navigation/native-stack": "^7.17.6",
    "expo": "^56.0.12",
    "expo-linear-gradient": "^57.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-native": "^0.86.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "latest",
    "tsx": "4.23.13",
    "typescript": "latest"
  }
}
