# ---- App (Expo) — copy to .env for local development. Inlined at build time; not secrets. ----
# The ShiftChess server (one Railway service: accounts, purchases, privacy page, online games)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080
# AdMob interstitial ad unit IDs. Leave empty to use Google's test ads.
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=

# ---- Server — set these as Railway variables on the service, not in the app. ----
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# PRIVACY_CONTACT_EMAIL=privacy@yourdomain.com
# APPLE_BUNDLE_ID=com.chainsoftwaregroup.shiftchess
# POSTMARK_SERVER_TOKEN=...                      (secret: password-reset emails)
# EMAIL_FROM=ShiftChess <no-reply@yourdomain.com> (a Postmark sender signature/domain)
# POSTMARK_MESSAGE_STREAM=outbound               (optional)
# GOOGLE_PLAY_PACKAGE_NAME=com.chainsoftwaregroup.shiftchess (Android only)
# GOOGLE_SERVICE_ACCOUNT_JSON={...}             (Android only, secret)
# ALLOWED_ORIGINS=https://your-web-build.example (only for a web build)
# PUBLIC_URL=https://your-domain                 (optional; defaults to Railway's domain)
