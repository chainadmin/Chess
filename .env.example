# ---- App (Expo) — copy to .env for local development. Inlined at build time; not secrets. ----
# Accounts API (Railway service "shiftchess-api")
EXPO_PUBLIC_API_URL=http://127.0.0.1:8788
# Game server (Railway service "shiftchess-game")
EXPO_PUBLIC_GAME_URL=http://127.0.0.1:8787
# AdMob interstitial ad unit IDs. Leave empty to use Google's test ads.
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=

# ---- Servers — set these as Railway service variables, not in the app. ----
# DATABASE_URL=${{Postgres.DATABASE_URL}}        (both services)
# ALLOWED_ORIGINS=https://your-web-build.example (both; only needed for a web build)
# PRIVACY_CONTACT_EMAIL=privacy@yourdomain.com   (api)
# APPLE_BUNDLE_ID=com.chainsoftwaregroup.shiftchess   (api)
# GOOGLE_PLAY_PACKAGE_NAME=com.chainsoftwaregroup.shiftchess (api)
# GOOGLE_SERVICE_ACCOUNT_JSON={...}             (api, secret)
# RESEND_API_KEY=re_...                          (api, secret: password-reset emails)
# EMAIL_FROM=ShiftChess <no-reply@yourdomain.com> (api)
# PUBLIC_URL=https://your-api-domain             (api, optional; defaults to Railway's domain)
