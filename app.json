{
  "expo": {
    "name": "ShiftChess",
    "slug": "shiftchess",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/app/icon.png",
    "scheme": "shiftchess",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.chainsoftwaregroup.shiftchess",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSUserTrackingUsageDescription": "This lets ShiftChess show ads that are more relevant to you. You can say no and still play everything."
      }
    },
    "android": {
      "package": "com.chainsoftwaregroup.shiftchess",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/adaptive-icon.png",
        "backgroundColor": "#120f18"
      },
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/app/icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/app/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#0b0a14"
        }
      ],
      "expo-secure-store",
      "expo-iap",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This lets ShiftChess show ads that are more relevant to you. You can say no and still play everything."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-1580761947831808~1314341731",
          "androidAppId": "ca-app-pub-1580761947831808~9362553843",
          "userTrackingUsageDescription": "This lets ShiftChess show ads that are more relevant to you. You can say no and still play everything.",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "231089ff-2290-472d-b0f3-811644d79101"
      }
    },
    "owner": "waypointsolutions2023"
  }
}
